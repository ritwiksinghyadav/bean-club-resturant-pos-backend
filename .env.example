# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bean_club

# Valkey Configuration (BullMQ drop-in replacement compatible with Redis protocol)
REDIS_URL=redis://localhost:6379

# JWT Configurations
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# WhatsApp Configuration
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_API_URL=https://api.whatsapp.example.com/v1

# Firebase Cloud Messaging (FCM)
FCM_SERVICE_ACCOUNT_JSON=
